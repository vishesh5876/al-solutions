{
  // Root Wrangler config so Cloudflare (dashboard / Workers Builds / CI) detects the project.
  // Build with `bun run build` (or `npm run build`) first — it emits dist/server + dist/client.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-solutions",
  "main": "dist/server/index.mjs",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "observability": { "enabled": true }
}
